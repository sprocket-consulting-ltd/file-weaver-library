{
  "fwlVersion": 1,
  "kind": "rule",
  "name": "Dash After Four Characters",
  "description": "Inserts a dash four characters into the name: IMG1234 becomes IMG1-234. Adjust the offset and text after importing to fit your naming scheme.",
  "author": "Sprocket Consulting",
  "website": "https://www.sprocketconsulting.co.uk/file-weaver",
  "minAppVersion": "1.4",
