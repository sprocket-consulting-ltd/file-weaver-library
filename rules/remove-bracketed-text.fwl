{
  "fwlVersion": 1,
  "kind": "rule",
  "name": "Remove Bracketed Text",
  "description": "Regex rule that deletes anything in round brackets, including the brackets and any space before them: \"report (final) (2).docx\" becomes \"report.docx\".",
  "author": "Sprocket Consulting",
  "website": "https://www.sprocketconsulting.co.uk/file-weaver",
  "minAppVersion": "1.4",
  "createdAt": "2026-07-03T09:00:00Z",
  "identifier": "22A7F64F-F516-48B4-9E9E-0EF8FD7C0653",
  "version": 1,
  "ruleType": "Regex Replace",
  "rule": {
    "type": "Regex Replace",
    "regexPattern": "\\s*\\([^)]*\\)",
    "regexReplacement": ""
  }
}
