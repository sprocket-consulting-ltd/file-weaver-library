{
  "fwlVersion": 1,
  "kind": "rule",
  "name": "Keep First Two Dash Segments",
  "description": "Regex rule that keeps only the first two ' - ' separated parts of a name and drops the rest - e.g. 'Show - s01e02 - Episode Title' becomes 'Show - s01e02'.",
  "author": "Sprocket Consulting",
  "website": "https://www.sprocketconsulting.co.uk/file-weaver",
  "minAppVersion": "1.4",
  "createdAt": "2026-07-03T17:27:52Z",
  "identifier": "67B6CB46-C2A2-4F56-A95B-5C7663435B7A",
  "version": 1,
  "ruleType": "Regex Replace",
  "rule": {
    "type": "Regex Replace",
    "regexPattern": "^(.*?)\\s-\\s(.*?)\\s-\\s(.*)$",
    "regexReplacement": "$1 - $2"
  }
}
